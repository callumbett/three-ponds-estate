"use client";

import Image from "next/image";

export type CarouselImage = { src: string; alt: string };

type Props = {
  images: CarouselImage[];
  /**
   * Optional override on the loop duration (seconds). Default 30s feels
   * like a slow estate tour. Lower = faster, higher = slower.
   */
  durationSeconds?: number;
};

/**
 * Horizontal marquee carousel — auto-scrolls right → left in a seamless
 * loop. The image set is rendered twice and the track is translated by
 * exactly -50% so the second set arrives where the first started, with
 * no visible jump.
 *
 * Per Bencium MOTION-SPEC §"Performance Rules":
 *   - Animates `transform` only (GPU-accelerated).
 *   - Pauses on hover so visitors can dwell on a frame.
 *   - Respects `prefers-reduced-motion` (the global rule in globals.css
 *     drops animation-duration to 0.001ms).
 */
export default function AmenityCarousel({
  images,
  durationSeconds = 30,
}: Props) {
  if (images.length === 0) return null;

  // Duplicate so translateX(-50%) lands the second set exactly where
  // the first started — seamless loop.
  const track = [...images, ...images];

  return (
    <div className="relative h-44 w-full overflow-hidden rounded-sm bg-parchment-deep sm:h-48">
      <div
        className="amenity-marquee flex h-full"
        style={
          { "--marquee-duration": `${durationSeconds}s` } as React.CSSProperties
        }
      >
        {track.map((img, i) => (
          <div
            key={`${img.src}-${i}`}
            className="relative h-full w-44 shrink-0 sm:w-48"
          >
            <Image
              src={img.src}
              alt={img.alt}
              fill
              sizes="192px"
              quality={75}
              className="object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  );
}
